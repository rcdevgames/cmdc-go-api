# Required. Numbered credentials are discovered dynamically; add _2, _3, ... as needed.
auth_cc_1=replace-with-commandcode-credential-1
auth_cc_2=replace-with-commandcode-credential-2

# Each proxy key gets an explicit upstream access scope.
apikey_1=replace-with-proxy-key-1
apikey_1_auth_cc=1,2

# Example restricted client:
# apikey_2=replace-with-proxy-key-2
# apikey_2_auth_cc=1

debug=false

# Optional overrides. Code defaults are used when omitted.
# HOST=127.0.0.1
# PORT=3000
# COMMAND_CODE_API_URL=https://api.commandcode.ai
# COMMAND_CODE_VERSION=1.36.0
# DEFAULT_MAX_TOKENS=32000
# REQUEST_TIMEOUT_MS=600000
# MAX_REQUEST_BYTES=20971520
