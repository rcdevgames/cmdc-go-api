# Required in every environment. The service crashes if any is missing.
auth_cc=replace-with-commandcode-credential
apikey=replace-with-proxy-key
debug=false

# Optional overrides. Code defaults are used when omitted.
# HOST=127.0.0.1
# PORT=3000
# COMMAND_CODE_API_URL=https://api.commandcode.ai
# COMMAND_CODE_VERSION=1.36.0
# DEFAULT_MAX_TOKENS=32000
# REQUEST_TIMEOUT_MS=600000
# MAX_REQUEST_BYTES=20971520
